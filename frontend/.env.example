# Local development (next dev): browser connects directly to the local backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Optional locally; required in Vercel's environment settings.
# An origin only: no /api suffix, credentials, query parameters, or fragment.
# Vercel requires HTTPS and a non-loopback host.
# BACKEND_ORIGIN=https://your-backend.canadacentral.azurecontainerapps.io
# Required in Vercel only: same server-only value configured on the Azure backend.
# TRUSTED_PROXY_SECRET=

# Local production verification (next build + next start) can instead use:
# BACKEND_ORIGIN=http://localhost:8080
