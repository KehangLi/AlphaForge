# Local development only. Copy to .env if needed; never use these values in Azure.
# Spring Boot does not automatically load .env. See docs/production-configuration.md.
SPRING_PROFILES_ACTIVE=local
DB_NAME=alphaforge
DB_URL=jdbc:postgresql://localhost:5432/alphaforge
DB_USERNAME=alphaforgeUser
DB_PASSWORD=alphaforgePass
DEV_SEED_DATA_ENABLED=true
# Optional: a local seed user password must contain 15-128 characters.
DEV_USER_PASSWORD=
