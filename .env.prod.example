# Reference template only. Configure these names in Azure at runtime.
# Never fill this tracked file with real production credentials.
SPRING_PROFILES_ACTIVE=prod
# Address only: no query parameters or embedded credentials. TLS is configured in the prod profile.
DB_URL=jdbc:postgresql://replace-me.postgres.database.azure.com:5432/alphaforge
DB_USERNAME=replace-me
# In Azure, reference a Container Apps secret named db-password for this variable.
DB_PASSWORD=
# Set the same independently generated server-only secret in Azure and Vercel.
# Generate once with: openssl rand -hex 32
TRUSTED_PROXY_SECRET=
SESSION_TIMEOUT=24h
# Optional until the frontend is deployed and browser/proxy behavior is verified.
CORS_ALLOWED_ORIGINS=
